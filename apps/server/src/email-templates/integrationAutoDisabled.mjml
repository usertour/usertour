<mjml>
  <mj-body background-color="#f1f1f1" width="100%">
    <mj-section background-color="#f3f5fb">
      <mj-column>
        <mj-text font-size="30px" align="center" color="#5534ff">
          Usertour
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#fff">
      <mj-column>
        <mj-text font-size="24px" align="center">
          An integration was disabled
        </mj-text>
        <mj-text align="left" color="#555" line-height="30px">
          Event deliveries to the following integration in {{projectName}} have been failing continuously for {{failingDays}} days, so Usertour has disabled it:
        </mj-text>
        <mj-text align="left" color="#333" font-family="monospace" font-size="14px" line-height="22px">
          {{providerName}}
        </mj-text>
        <mj-text align="left" color="#555" line-height="30px">
          No events are being sent to it. The most common cause is a revoked or rotated API key — update the key and re-enable the integration to resume delivery. If you no longer need it, you can delete it.
        </mj-text>
        <mj-button background-color="#5534ff" border-radius="50px" color="white" font-size="15px" href="{{settingsUrl}}">
          Open integration settings
        </mj-button>
        <mj-text align="left" color="#555" line-height="20px">
          The Usertour Team
        </mj-text>
        <mj-divider border-color="#5534ff" border-width="2px"></mj-divider>
        <mj-text font-size="12px" color="#555">
          If you’re having trouble with the button above, copy and paste the URL below into your web browser.
        </mj-text>
        <mj-text font-size="12px" color="#555"> {{settingsUrl}} </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
