# POSTGRES
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=usertour

# Nest run locally
DB_HOST=postgres
DB_PORT=5432
DB_SCHEMA=usertour

# Prisma database connection
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${DB_HOST}:${DB_PORT}/${POSTGRES_DB}?schema=${DB_SCHEMA}&sslmode=prefer

# Nest
PORT=3000


# Email
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=

#Redis
Redis_HOST=
Redis_PORT=
Redis_PASS=
Redis_TLS=
# Logical database index (0-15). Leave unset for 0; e2e uses 1 by default.
Redis_DB=

APP_HOMEPAGE_URL=https://localhost

# AWS S3
AWS_S3_REGION=
AWS_S3_ENDPOINT=
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_DOMAIN=

# JWT
JWT_SECRET=test
# Optional: a separate secret for refresh tokens (defaults to JWT_SECRET).
# Setting or changing it invalidates every stored refresh token: all users
# sign in again once, within an access token's lifetime.
# JWT_REFRESH_SECRET=
JWT_EXPIRATION_TIME=1h
JWT_REFRESH_EXPIRATION_TIME=7d

# Email Authentication
EMAIL_AUTH_ENABLED=false
EMAIL_SENDER=

# GitHub Authentication
GITHUB_AUTH_ENABLED=false
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional — defaults to <API_URL>/api/auth/github/callback when unset
GITHUB_CALLBACK_URL=

# Google Authentication
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional — defaults to <API_URL>/api/auth/google/callback when unset
GOOGLE_CALLBACK_URL=

# SSO (OIDC) — optional callback override; defaults to <API_URL>/api/auth/sso/callback
SSO_CALLBACK_URL=

# Outbound Security
# Set to true only if your SSO identity provider is reachable on an internal network
ALLOW_PRIVATE_NETWORK_EGRESS=false

# AI (optional)
# Instance-level AI provider — currently powers machine translation in the
# localization editor. The features enable per provider: 'anthropic' (the
# default) needs AI_API_KEY; 'openai-compatible' needs AI_BASE_URL and
# covers any OpenAI-shaped gateway (AI_API_KEY optional — local gateways
# may be keyless); 'bedrock' enables on selection alone.
# 'bedrock' uses a Bedrock model id in AI_MODEL and, in precedence order:
# AI_API_KEY as a Bedrock API key, the AWS key pair below, or keyless via
# the AWS default credential chain (env vars, profile, EC2/EKS instance role
# — selecting the provider alone enables the features). Region falls back to
# AWS_REGION.
AI_API_KEY=
AI_PROVIDER=anthropic
AI_MODEL=claude-opus-4-8
AI_BASE_URL=
AI_AWS_REGION=
AI_AWS_ACCESS_KEY_ID=
AI_AWS_SECRET_ACCESS_KEY=

# Stripe Configuration
STRIPE_API_KEY=
STRIPE_ACCOUNT_WEBHOOK_SECRET=test
STRIPE_ACCOUNT_TEST_WEBHOOK_SECRET=test
STRIPE_SESSION_SUCCESS_URL=
STRIPE_SESSION_CANCEL_URL=
STRIPE_PORTAL_RETURN_URL=

# OpenTelemetry. Off until an exporter has somewhere to send to: the
# collector's base URL (/v1/traces and /v1/metrics are appended), or per
# signal OTEL_EXPORTER_OTLP_TRACES_ENDPOINT / OTEL_EXPORTER_OTLP_METRICS_ENDPOINT.
# The standard variables apply: OTEL_EXPORTER_OTLP_PROTOCOL (http/protobuf),
# OTEL_EXPORTER_OTLP_HEADERS, OTEL_TRACES_EXPORTER / OTEL_METRICS_EXPORTER /
# OTEL_LOGS_EXPORTER (otlp, console, none; a collector that takes traces only
# wants the other two set to none), OTEL_METRIC_EXPORT_INTERVAL (ms, 60000),
# OTEL_SERVICE_NAME (usertour-server), OTEL_RESOURCE_ATTRIBUTES, OTEL_SDK_DISABLED,
# OTEL_LOG_LEVEL (the SDK's own diagnostics; silent unless set).
# Volume: OTEL_TRACES_SAMPLER (parentbased_traceidratio) with
# OTEL_TRACES_SAMPLER_ARG (0.1 keeps one trace in ten); every instrumentation
# the SDK ships is on, OTEL_NODE_DISABLED_INSTRUMENTATIONS=dns,net drops the
# connection-level spans under each outbound call.
OTEL_EXPORTER_OTLP_ENDPOINT=

# HubSpot CRM sync (ADR 0013). Usertour Cloud uses its own HubSpot app; when
# self-hosting, upload integrations/hubspot to your HubSpot developer account
# and paste that app's credentials here. The callback defaults to
# ${API_URL}/api/integrations/hubspot/oauth/callback and must be registered on the app.
# It must be served by the host the dashboard sends API requests to: the OAuth
# transaction cookie is set by the dashboard's request and read back on the callback.
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
# HUBSPOT_CALLBACK_URL=

# WebSocket admission control (per replica). Units of work are handshakes and
# client messages; at most WS_ADMISSION_CONCURRENCY run at a time, the rest
# queue and are refused after the wait below. WS_HANDSHAKE_RATE_PER_SECOND
# paces new connections (same burst allowance). The concurrency and the rate
# are off at 0; a wait of 0 never refuses. A blank value means the default.
# WS_ADMISSION_CONCURRENCY=16
# WS_ADMISSION_HANDSHAKE_WAIT_MS=15000
# WS_ADMISSION_MESSAGE_WAIT_MS=15000
# WS_HANDSHAKE_RATE_PER_SECOND=50
