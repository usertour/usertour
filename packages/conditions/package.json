  },
  "dependencies": {
    "@radix-ui/react-icons": "^1.3.0",
    "@usertour/constants": "workspace:^",
    "@usertour/icons": "workspace:^",
    "@usertour/data": "workspace:^",
    "@usertour/helpers": "workspace:^",
    "@usertour/tailwind": "workspace:^",
    "@usertour/ui": "workspace:^",
    "@usertour/types": "workspace:^",
    "date-fns": "^2.30.0",
    "fast-deep-equal": "^3.1.3",
    "react": "^18.2.0"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.0.37",
    "@types/react-dom": "^18.0.11",
    "@typescript-eslint/eslint-plugin": "^5.59.0",
    "@typescript-eslint/parser": "^5.59.0",
    "eslint": "^8.38.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.3.4",
    "react": "^18.2.0",
    "typescript": "^5.0.2"
  },
  "tsup": {
    "clean": true,
    "target": "es2019",
    "format": ["cjs", "esm"]
  }
