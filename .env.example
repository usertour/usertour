# Postgres
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/usertour?schema=usertour&sslmode=prefer
DATABASE_DIRECT_URL=${DATABASE_URL}

# Email
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=

#Redis
Redis_HOST=redis
Redis_PORT=6379
Redis_PASS=
Redis_USER=
Redis_TLS=false

# App serve
# If you are developing locally, you can use http://[ip]:[port].
APP_HOMEPAGE_URL=

# AWS S3
AWS_S3_REGION=
AWS_S3_ENDPOINT=
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_DOMAIN=

# JWT
JWT_SECRET=test
JWT_EXPIRATION_TIME=1h
JWT_REFRESH_EXPIRATION_TIME=7d

# Email Authentication
EMAIL_AUTH_ENABLED=true
EMAIL_SENDER=YourApp <your-email@example.com>

# GitHub Authentication
GITHUB_AUTH_ENABLED=false
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional — defaults to <API_URL>/api/auth/github/callback when unset
GITHUB_CALLBACK_URL=http://localhost:8011/api/auth/github/callback

# Google Authentication
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional — defaults to <API_URL>/api/auth/google/callback when unset
GOOGLE_CALLBACK_URL=http://localhost:8011/api/auth/google/callback

# SSO (OIDC) — optional callback override; defaults to <API_URL>/api/auth/sso/callback
SSO_CALLBACK_URL=

# Outbound Security
# Set to true only if your SSO identity provider is reachable on an internal network
ALLOW_PRIVATE_NETWORK_EGRESS=false

# Login redirect url
LOGIN_REDIRECT_URL=/env/1/flows

# Cookie
USERTOUR_COOKIE_DOMAIN=
USERTOUR_COOKIE_SECURE=

# Stripe Configuration
STRIPE_API_KEY=
STRIPE_ACCOUNT_WEBHOOK_SECRET=
STRIPE_ACCOUNT_TEST_WEBHOOK_SECRET=
STRIPE_SESSION_SUCCESS_URL=
STRIPE_SESSION_CANCEL_URL=
STRIPE_PORTAL_RETURN_URL=

# Node
NODE_ENV=production

# Web api url
API_URL=""
# Optional — full public MCP endpoint; defaults to <API_URL>/mcp. Drives the
# Settings → MCP display AND the OAuth metadata/401 challenge, so set it when
# MCP is served on its own domain (which must also proxy /oauth/* and
# /.well-known/oauth-*).
# MCP_SERVER_URL=""

# v2 API rate limiting — all optional. Window length in ms; the flat per-token
# limit for self-hosted deployments (cloud is plan-tiered instead); and the
# per-IP limit applied to unauthenticated/invalid-token requests.
# API_THROTTLE_TTL=60000
# API_THROTTLE_LIMIT=1000
# API_THROTTLE_FALLBACK_LIMIT=100

# Express "trust proxy" — which upstream proxies to believe when resolving the
# client IP (rate limiting) and protocol. Default trusts loopback + private
# networks: the bundled nginx and any in-network proxy in front of it, with
# the trust chain stopping at the first public address. Accepts any value
# Express supports (a hop count, an address list, or false when the Node
# server is exposed directly). https://expressjs.com/en/guide/behind-proxies.html
# TRUST_PROXY="loopback, linklocal, uniquelocal"

# (redeploy trigger 2 — no runtime effect)
